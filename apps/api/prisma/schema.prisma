generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext]
}

enum GlobalRole {
  ADMIN
  PROJECT_MANAGER
  TEAM_MEMBER
  VIEWER
}

enum ProjectRole {
  MANAGER
  MEMBER
  VIEWER
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique @db.Citext
  name         String     @db.VarChar(100)
  handle       String     @unique @db.VarChar(50)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  globalRole   GlobalRole @default(TEAM_MEMBER) @map("global_role")
  isActive     Boolean    @default(true) @map("is_active")
  avatarSeed   String?    @map("avatar_seed") @db.VarChar(100)
  lastLoginAt  DateTime?  @map("last_login_at")
  tokenVersion Int        @default(1) @map("token_version")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  refreshTokens  RefreshToken[]
  createdProjects Project[]       @relation("ProjectCreator")
  projectMembers  ProjectMember[]
  assignedTasks   Task[]          @relation("TaskAssignee")
  reportedTasks   Task[]          @relation("TaskReporter")
  comments        Comment[]
  notifications   Notification[]  @relation("NotificationRecipient")
  actionsDone     Notification[]  @relation("NotificationActor")
  activityLogs    ActivityLog[]

  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @map("token_hash") @db.VarChar(255)
  familyId   String    @map("family_id") @db.Uuid
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  userAgent  String?   @map("user_agent") @db.VarChar(255)
  ip         String?   @db.VarChar(45)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Project {
  id          String        @id @default(uuid()) @db.Uuid
  name        String        @db.VarChar(100)
  key         String        @unique @db.VarChar(10)
  description String?       @db.VarChar(500)
  status      ProjectStatus @default(ACTIVE)
  archivedAt  DateTime?     @map("archived_at")
  createdBy   String        @map("created_by") @db.Uuid
  taskCounter Int           @default(0) @map("task_counter")
  version     Int           @default(1)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  creator       User            @relation("ProjectCreator", fields: [createdBy], references: [id])
  members       ProjectMember[]
  tasks         Task[]
  comments      Comment[]
  notifications Notification[]
  activityLogs  ActivityLog[]

  @@map("projects")
}

model ProjectMember {
  id          String      @id @default(uuid()) @db.Uuid
  projectId   String      @map("project_id") @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  projectRole ProjectRole @default(MEMBER) @map("project_role")
  addedBy     String      @map("added_by") @db.Uuid
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model Task {
  id          String       @id @default(uuid()) @db.Uuid
  projectId   String       @map("project_id") @db.Uuid
  number      Int
  title       String       @db.VarChar(200)
  description String?      @db.Text
  status      TaskStatus   @default(BACKLOG)
  priority    TaskPriority @default(MEDIUM)
  assigneeId  String?      @map("assignee_id") @db.Uuid
  reporterId  String       @map("reporter_id") @db.Uuid
  dueDate     DateTime?    @map("due_date")
  position    Float        @default(1000)
  version     Int          @default(1)
  deletedAt   DateTime?    @map("deleted_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter User      @relation("TaskReporter", fields: [reporterId], references: [id])
  comments Comment[]

  @@unique([projectId, number])
  @@index([projectId, status, position])
  @@index([assigneeId])
  @@map("tasks")
}

model Comment {
  id        String    @id @default(uuid()) @db.Uuid
  taskId    String    @map("task_id") @db.Uuid
  projectId String    @map("project_id") @db.Uuid
  authorId  String    @map("author_id") @db.Uuid
  body      String    @db.Text
  mentions  String[]  @default([]) @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])

  @@index([taskId, createdAt])
  @@index([projectId])
  @@map("comments")
}

model Notification {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  type       String    @db.VarChar(50)
  projectId  String?   @map("project_id") @db.Uuid
  entityType String    @map("entity_type") @db.VarChar(50)
  entityId   String    @map("entity_id") @db.VarChar(100)
  actorId    String    @map("actor_id") @db.Uuid
  payload    Json      @default("{}")
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  recipient User     @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor     User     @relation("NotificationActor", fields: [actorId], references: [id])
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}

model ActivityLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  projectId  String?  @map("project_id") @db.Uuid
  action     String   @db.VarChar(80)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String   @map("entity_id") @db.VarChar(100)
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  actor   User     @relation(fields: [userId], references: [id])
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt(sort: Desc)])
  @@index([userId])
  @@map("activity_logs")
}
