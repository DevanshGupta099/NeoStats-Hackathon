# Database (PostgreSQL 16)
DATABASE_URL=postgresql://forgeline:forgeline_secret@localhost:5432/forgeline_dev?schema=public
TEST_DATABASE_URL=postgresql://forgeline:forgeline_secret@localhost:5433/forgeline_test?schema=public

# Authentication & Security
JWT_ACCESS_SECRET=forgeline_dev_jwt_access_secret_min_32_chars_long_key_sample_1234
JWT_REFRESH_SECRET=forgeline_dev_jwt_refresh_secret_min_32_chars_long_key_sample_5678
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Ports & Origins
API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:4000

# AI Features (Optional / Phase 8 - free tier)
AI_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GOOGLE_AI_API_KEY=
